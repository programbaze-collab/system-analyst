<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PriceLoad"
                  targetNamespace="http://example.com/bpmn/price-load">

  <bpmn:collaboration id="Collaboration_PriceLoad">
    <bpmn:participant id="Participant_Shop" name="Интернет-магазин: загрузка прайса поставщика" processRef="Process_PriceLoad" />
    <bpmn:participant id="Participant_Supplier" name="Поставщик" />
    <bpmn:messageFlow id="Flow_Message_Price" name="Прайс в XML" sourceRef="Participant_Supplier" targetRef="Task_Download" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PriceLoad" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="Система обмена">
        <bpmn:flowNodeRef>Start_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Normalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Disputed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Loaded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveDecisions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HideStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotUpdated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Контент-менеджер">
        <bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_24h</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="Ответственный за обмен">
        <bpmn:flowNodeRef>Task_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Schedule" name="Время загрузки по расписанию">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Schedule" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Download" name="Скачать и разобрать прайс">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Parsed" name="Прайс получен и разобран?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Parsed_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parsed_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Normalize" name="Привести артикулы к единому виду">
      <bpmn:incoming>Flow_Parsed_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Match" name="Сопоставить позиции с товарами">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Apply" name="Применить позиции, спорные — в очередь">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Disputed" name="Есть спорные позиции?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Disputed_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Disputed_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManualReview" name="Разобрать спорные позиции">
      <bpmn:incoming>Flow_Disputed_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Timer_24h" name="24 часа" cancelActivity="false" attachedToRef="Task_ManualReview">
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_24h" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_Escalation" name="Выяснить причину задержки">
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Escalated" name="Эскалация обработана">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_SaveDecisions" name="Сохранить решения, применить позиции">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_Disputed_No</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Loaded" name="Прайс загружен">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_NotifyFailure" name="Уведомить ответственного о сбое">
      <bpmn:incoming>Flow_Parsed_No</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="Gateway_Stale" name="Прошлому прайсу больше 24 часов?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Stale_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stale_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_HideStock" name="Скрыть остатки поставщика">
      <bpmn:incoming>Flow_Stale_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_NotUpdated" name="Прайс не обновлён">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_Stale_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Schedule" targetRef="Task_Download" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Download" targetRef="Gateway_Parsed" />
    <bpmn:sequenceFlow id="Flow_Parsed_Yes" name="да" sourceRef="Gateway_Parsed" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="Flow_Parsed_No" name="нет" sourceRef="Gateway_Parsed" targetRef="Task_NotifyFailure" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Normalize" targetRef="Task_Match" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Match" targetRef="Task_Apply" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Apply" targetRef="Gateway_Disputed" />
    <bpmn:sequenceFlow id="Flow_Disputed_No" name="нет" sourceRef="Gateway_Disputed" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Disputed_Yes" name="да" sourceRef="Gateway_Disputed" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ManualReview" targetRef="Task_SaveDecisions" />
    <bpmn:sequenceFlow id="Flow_Escalate" sourceRef="Timer_24h" targetRef="Task_Escalation" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Escalation" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SaveDecisions" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Merge" targetRef="End_Loaded" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyFailure" targetRef="Gateway_Stale" />
    <bpmn:sequenceFlow id="Flow_Stale_Yes" name="да" sourceRef="Gateway_Stale" targetRef="Task_HideStock" />
    <bpmn:sequenceFlow id="Flow_Stale_No" name="нет" sourceRef="Gateway_Stale" targetRef="End_NotUpdated" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_HideStock" targetRef="End_NotUpdated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_PriceLoad">
    <bpmndi:BPMNPlane id="Plane_PriceLoad" bpmnElement="Collaboration_PriceLoad">
      <bpmndi:BPMNShape id="Participant_Shop_di" bpmnElement="Participant_Shop" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="1360" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1330" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="130" y="380" width="1330" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true">
        <dc:Bounds x="130" y="540" width="1330" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Supplier_di" bpmnElement="Participant_Supplier" isHorizontal="true">
        <dc:Bounds x="100" y="760" width="1360" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Schedule_di" bpmnElement="Start_Schedule">
        <dc:Bounds x="172" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="160" y="175" width="60" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Download_di" bpmnElement="Task_Download">
        <dc:Bounds x="250" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parsed_di" bpmnElement="Gateway_Parsed" isMarkerVisible="true">
        <dc:Bounds x="395" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="372" y="88" width="96" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Normalize_di" bpmnElement="Task_Normalize">
        <dc:Bounds x="490" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Match_di" bpmnElement="Task_Match">
        <dc:Bounds x="640" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Apply_di" bpmnElement="Task_Apply">
        <dc:Bounds x="790" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Disputed_di" bpmnElement="Gateway_Disputed" isMarkerVisible="true">
        <dc:Bounds x="945" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="926" y="88" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1235" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Loaded_di" bpmnElement="End_Loaded">
        <dc:Bounds x="1332" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1310" y="175" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualReview_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="920" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_24h_di" bpmnElement="Timer_24h">
        <dc:Bounds x="952" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="994" y="510" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalation_di" bpmnElement="Task_Escalation">
        <dc:Bounds x="920" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Escalated_di" bpmnElement="End_Escalated">
        <dc:Bounds x="1072" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1050" y="645" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveDecisions_di" bpmnElement="Task_SaveDecisions">
        <dc:Bounds x="1080" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyFailure_di" bpmnElement="Task_NotifyFailure">
        <dc:Bounds x="470" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Stale_di" bpmnElement="Gateway_Stale" isMarkerVisible="true">
        <dc:Bounds x="620" y="265" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="596" y="223" width="98" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HideStock_di" bpmnElement="Task_HideStock">
        <dc:Bounds x="720" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotUpdated_di" bpmnElement="End_NotUpdated">
        <dc:Bounds x="870" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="850" y="236" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="150" /><di:waypoint x="250" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="350" y="150" /><di:waypoint x="395" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Parsed_Yes_di" bpmnElement="Flow_Parsed_Yes">
        <di:waypoint x="445" y="150" /><di:waypoint x="490" y="150" />
        <bpmndi:BPMNLabel><dc:Bounds x="458" y="132" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Parsed_No_di" bpmnElement="Flow_Parsed_No">
        <di:waypoint x="420" y="175" /><di:waypoint x="420" y="290" /><di:waypoint x="470" y="290" />
        <bpmndi:BPMNLabel><dc:Bounds x="426" y="215" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="150" /><di:waypoint x="640" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="740" y="150" /><di:waypoint x="790" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="890" y="150" /><di:waypoint x="945" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Disputed_No_di" bpmnElement="Flow_Disputed_No">
        <di:waypoint x="995" y="150" /><di:waypoint x="1235" y="150" />
        <bpmndi:BPMNLabel><dc:Bounds x="1005" y="132" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Disputed_Yes_di" bpmnElement="Flow_Disputed_Yes">
        <di:waypoint x="970" y="175" /><di:waypoint x="970" y="420" />
        <bpmndi:BPMNLabel><dc:Bounds x="976" y="200" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1020" y="460" /><di:waypoint x="1130" y="460" /><di:waypoint x="1130" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalate_di" bpmnElement="Flow_Escalate">
        <di:waypoint x="970" y="518" /><di:waypoint x="970" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1020" y="620" /><di:waypoint x="1072" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1180" y="290" /><di:waypoint x="1260" y="290" /><di:waypoint x="1260" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1285" y="150" /><di:waypoint x="1332" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="570" y="290" /><di:waypoint x="620" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stale_Yes_di" bpmnElement="Flow_Stale_Yes">
        <di:waypoint x="670" y="290" /><di:waypoint x="720" y="290" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="272" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stale_No_di" bpmnElement="Flow_Stale_No">
        <di:waypoint x="645" y="315" /><di:waypoint x="645" y="355" /><di:waypoint x="888" y="355" /><di:waypoint x="888" y="308" />
        <bpmndi:BPMNLabel><dc:Bounds x="651" y="330" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="820" y="290" /><di:waypoint x="870" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Message_Price_di" bpmnElement="Flow_Message_Price">
        <di:waypoint x="300" y="760" /><di:waypoint x="300" y="190" />
        <bpmndi:BPMNLabel><dc:Bounds x="306" y="723" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
